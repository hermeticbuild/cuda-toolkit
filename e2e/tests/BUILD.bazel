load("@cuda//cuda:selects.bzl", "CUDA_VERSIONS")
load(":toolchain_selection_check.bzl", "toolchain_selection_check")

toolchain_selection_check(
    name = "toolchain_selection_check",
    expected_repository = select({
        "@cuda//:is_cuda_{}".format(version.replace(".", "_")): "cuda_{}__cuda_nvcc__".format(version.replace(".", "_"))
        for version in CUDA_VERSIONS
    }),
    tags = ["manual"],
)

[
    platform(
        name = "platform_linux_{}_exec".format(arch),
        constraint_values = [
            "@platforms//os:linux",
            "@platforms//cpu:{}".format(cpu),
        ],
    )
    for arch, cpu in [
        ("amd64", "x86_64"),
        ("arm64", "aarch64"),
    ]
]
