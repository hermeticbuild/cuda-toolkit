"""BUILD definitions for cuda_tensorrt package"""

# This BUILD file is used within the arch specific cuda redist repository.
#
# Any user-facing target should be listed in _REPO_PUBLIC_TARGETS so that the
# @cuda_tensorrt proxy repository can re-export it.
#
# No nvinfer_static or nvinfer_plugin_static targets are exposed:
# libnvinfer_static.a (and through it libnvinfer_plugin_static.a) references
# builder-resource kernel blobs (_binary_*_klib_* symbols) that the GA tarball
# ships only inside the dlopened libnvinfer_builder_resource_*.so files, so no
# hermetic static closure can be assembled from the redistribution.
# libnvonnxparser_static.a is self-contained (it vendors its protobuf and onnx
# proto objects) and is exposed.

load("@cuda_toolkit//cuda:versions_helper.bzl", "if_version_equal_or_greater_than")
load("@rules_cc//cc:cc_import.bzl", "cc_import")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@{cuda_redist_repo}//:version.bzl", "CUDA_VERSION")
load("//:version.bzl", "LIB_VERSIONS")

cc_import(
    name = "nvinfer_shared_library",
    deps = [":headers"],
    shared_library = "lib/libnvinfer.so." + LIB_VERSIONS["libnvinfer"],
    visibility = ["//visibility:public"],
)

cc_import(
    name = "nvinfer_interface_library",
    deps = [":headers"],
    interface_library = "lib/stubs/libnvinfer.so",
    system_provided = True,
    visibility = ["//visibility:public"],
)

cc_import(
    name = "nvinfer_plugin_shared_library",
    deps = [":headers"],
    shared_library = "lib/libnvinfer_plugin.so." + LIB_VERSIONS["libnvinfer_plugin"],
    visibility = ["//visibility:public"],
)

cc_import(
    name = "nvinfer_plugin_interface_library",
    deps = [":headers"],
    interface_library = "lib/stubs/libnvinfer_plugin.so",
    system_provided = True,
    visibility = ["//visibility:public"],
)

cc_import(
    name = "nvonnxparser_shared_library",
    deps = [":headers"],
    shared_library = "lib/libnvonnxparser.so." + LIB_VERSIONS["libnvonnxparser"],
    visibility = ["//visibility:public"],
)

cc_import(
    name = "nvonnxparser_interface_library",
    deps = [":headers"],
    interface_library = "lib/stubs/libnvonnxparser.so",
    system_provided = True,
    visibility = ["//visibility:public"],
)

cc_import(
    name = "nvonnxparser_static_library",
    deps = [":headers"],
    static_library = "lib/libnvonnxparser_static.a",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "nvinfer",
    deps = [":nvinfer_shared_library"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "nvinfer_system",
    deps = [":nvinfer_interface_library"],
    visibility = ["//visibility:public"],
)

# libnvinfer_plugin.so declares libnvinfer.so.10 in DT_NEEDED.
cc_library(
    name = "nvinfer_plugin",
    deps = [
        ":nvinfer",
        ":nvinfer_plugin_shared_library",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "nvinfer_plugin_system",
    deps = [
        ":nvinfer_plugin_interface_library",
        ":nvinfer_system",
    ],
    visibility = ["//visibility:public"],
)

# libnvonnxparser reaches nvinfer only through consumer-provided interface
# pointers (it has no DT_NEEDED on libnvinfer), so the parser wrappers carry
# no cross-library dependency.
cc_library(
    name = "nvonnxparser",
    deps = [":nvonnxparser_shared_library"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "nvonnxparser_system",
    deps = [":nvonnxparser_interface_library"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "nvonnxparser_static",
    deps = [":nvonnxparser_static_library"],
    linkopts = [
        "-lpthread",
        "-ldl",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "shared_library_files",
    # libnvinfer dlopens the per-SM builder resources and the lean and
    # dispatch runtimes, and the loader resolves the libraries through their
    # SONAME symlinks (for example libnvinfer.so.10), so ship every packaged
    # shared-library file alongside the linkable libraries. The Windows
    # cross-compilation builder resources (lib/*_win_*) are excluded.
    srcs = glob(
        ["lib/lib*.so*"],
        exclude = ["lib/*_win_*"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "header_list",
    srcs = glob(["include/**/*.h"]),
    visibility = ["//visibility:public"],
)

cc_library(
    name = "headers",
    hdrs = [":header_list"],
    # NvInferRuntimeBase.h includes cuda_runtime_api.h.
    deps = ["@{cuda_redist_repo}//cudart:headers"] + if_version_equal_or_greater_than(
        CUDA_VERSION,
        "13.0.0",
        ["@{cuda_redist_repo}//crt:headers"],
    ),
    includes = ["include"],
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
)
