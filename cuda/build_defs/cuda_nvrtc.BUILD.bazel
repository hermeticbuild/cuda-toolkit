"""BUILD definitions for cuda_nvrtc package"""

# This BUILD file is used within the arch specific cuda redist repository.
#
# Any user-facing target should be listed in _REPO_PUBLIC_TARGETS so that the
# @cuda_nvrtc proxy repository can re-export it.

load("@cuda_toolkit//cuda:versions_helper.bzl", "if_version_equal_or_greater_than")
load("@rules_cc//cc:cc_import.bzl", "cc_import")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@{cuda_redist_repo}//:version.bzl", "CUDA_VERSION")
load("//:version.bzl", "LIB_SONAME_VERSIONS", "LIB_VERSIONS")

cc_import(
    name = "nvrtc_main",
    deps = [":headers"],
    shared_library = "lib/libnvrtc.so." + LIB_SONAME_VERSIONS["libnvrtc"],
    visibility = ["//visibility:public"],
)

cc_import(
    name = "nvrtc_builtins_shared_library",
    deps = [":headers"],
    shared_library = "lib/libnvrtc-builtins.so." + LIB_SONAME_VERSIONS["libnvrtc-builtins"],
    visibility = ["//visibility:public"],
)

cc_import(
    name = "nvrtc_builtins_interface_library",
    deps = [":headers"],
    interface_library = "lib/libnvrtc-builtins.so",
    system_provided = True,
    visibility = ["//visibility:public"],
)

cc_import(
    name = "nvrtc_static_library",
    deps = [":headers"],
    static_library = "lib/libnvrtc_static.a",
)

cc_import(
    name = "nvrtc_builtins_static_library",
    deps = [":headers"],
    static_library = "lib/libnvrtc-builtins_static.a",
)

cc_library(
    name = "nvrtc_builtins",
    deps = [":nvrtc_builtins_shared_library"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "nvrtc_builtins_system",
    deps = [":nvrtc_builtins_interface_library"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "nvrtc",
    deps = [":nvrtc_main", ":nvrtc_builtins"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "nvrtc_system",
    deps = [":nvrtc_stub", ":nvrtc_builtins_system"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "nvrtc_static",
    deps = [
        ":nvrtc_static_library",
        ":nvrtc_builtins_static",
        "@{cuda_redist_repo}//nvcc:nvptxcompiler",
    ] + if_version_equal_or_greater_than(
        CUDA_VERSION,
        "13.0.0",
        ["@{cuda_redist_repo}//nvfatbin:nvfatbin_static"],
    ),
    visibility = ["//visibility:public"],
)

cc_library(
    name = "nvrtc_builtins_static",
    deps = [":nvrtc_builtins_static_library"],
    visibility = ["//visibility:public"],
)

cc_import(
    name = "nvrtc_stub",
    deps = [":headers"],
    interface_library = "lib/stubs/libnvrtc.so",
    system_provided = 1,
    visibility = ["//visibility:public"],
)

filegroup(
    name = "shared_library_files",
    srcs = [
        "lib/libnvrtc.so." + LIB_VERSIONS["libnvrtc"],
        "lib/libnvrtc-builtins.so." + LIB_VERSIONS["libnvrtc-builtins"],
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "header_list",
    srcs = [
        "include/nvrtc.h",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "headers",
    hdrs = [":header_list"],
    includes = ["include"],
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
)
