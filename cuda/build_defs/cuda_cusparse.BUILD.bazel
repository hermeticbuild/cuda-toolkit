"""BUILD definitions for cuda_cusparse package"""

# This BUILD file is used within the arch specific cuda redist repository.
#
# Any user-facing target should be listed in _REPO_PUBLIC_TARGETS so that the
# @cuda_cusparse proxy repository can re-export it.

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_import.bzl", "cc_import")
load("//:version.bzl", "LIB_SONAME_VERSIONS", "LIB_VERSIONS")

cc_import(
    name = "cusparse_shared_library",
    shared_library = "lib/libcusparse.so." + LIB_SONAME_VERSIONS["libcusparse"],
    deps = ["@{cuda_redist_repo}//nvjitlink:nvjitlink_shared_library", ":headers"],
    visibility = ["//visibility:public"],
)

cc_import(
    name = "cusparse_interface_library",
    deps = [":headers"],
    interface_library = "lib/stubs/libcusparse.so",
    system_provided = True,
    visibility = ["//visibility:public"],
)

cc_import(
    name = "cusparse_static_library",
    deps = [":headers"],
    static_library = "lib/libcusparse_static.a",
)

cc_library(
    name = "cusparse",
    deps = [":cusparse_shared_library"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "cusparse_system",
    deps = [
        ":cusparse_interface_library",
        "@{cuda_redist_repo}//nvjitlink:nvjitlink_system",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "cusparse_static",
    deps = [":cusparse_static_library", "@{cuda_redist_repo}//nvjitlink:nvjitlink_static"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "shared_library_files",
    srcs = [
        "lib/libcusparse.so." + LIB_VERSIONS["libcusparse"],
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "header_list",
    srcs = [
        "include/cusparse.h",
        "include/cusparse_v2.h",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "headers",
    hdrs = [":header_list"],
    includes = ["include"],
    deps = [
        "@{cuda_redist_repo}//cudart:headers",
        "@{cuda_redist_repo}//nvjitlink:headers",
    ],
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
)
