"""BUILD definitions for cuda_nvjpeg package"""

load("@rules_cc//cc:cc_import.bzl", "cc_import")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//:version.bzl", "LIB_SONAME_VERSIONS", "LIB_VERSIONS")

cc_import(
    name = "nvjpeg_shared_library",
    deps = [":headers"],
    shared_library = "lib/libnvjpeg.so." + LIB_SONAME_VERSIONS["libnvjpeg"],
    visibility = ["//visibility:public"],
)

cc_import(
    name = "nvjpeg_interface_library",
    deps = [":headers"],
    interface_library = "lib/stubs/libnvjpeg.so",
    system_provided = True,
    visibility = ["//visibility:public"],
)

cc_import(
    name = "nvjpeg_static_library",
    deps = [":headers"],
    static_library = "lib/libnvjpeg_static.a",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "nvjpeg",
    deps = [":nvjpeg_shared_library"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "nvjpeg_system",
    deps = [":nvjpeg_interface_library"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "nvjpeg_static",
    linkopts = ["-lpthread", "-ldl"],
    deps = [
        ":nvjpeg_static_library",
        "@{cuda_redist_repo}//cudart:static",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "shared_library_files",
    srcs = ["lib/libnvjpeg.so." + LIB_VERSIONS["libnvjpeg"]],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "header_list",
    srcs = ["include/nvjpeg.h"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "headers",
    hdrs = [":header_list"],
    deps = ["@{cuda_redist_repo}//cudart:headers"],
    includes = ["include"],
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
)
