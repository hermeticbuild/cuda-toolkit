"""BUILD definitions for cuda_cudnn package"""

# This BUILD file is used within the arch specific cuda redist repository.
#
# Any user-facing target should be listed in _REPO_PUBLIC_TARGETS so that the
# @cuda_cudnn proxy repository can re-export it.

load("@cuda_toolkit//cuda:versions_helper.bzl", "if_version_equal_or_greater_than")
load("@rules_cc//cc:cc_import.bzl", "cc_import")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@{cuda_redist_repo}//:version.bzl", "CUDA_VERSION")
load("//:version.bzl", "LIB_SONAME_VERSIONS")

cc_import(
    name = "cudnn_ops",
    deps = [":headers"],
    shared_library = "lib/libcudnn_ops.so." + LIB_SONAME_VERSIONS["libcudnn_ops"],
    visibility = ["//visibility:public"],
)

cc_import(
    name = "cudnn_cnn",
    deps = [":headers"],
    shared_library = "lib/libcudnn_cnn.so." + LIB_SONAME_VERSIONS["libcudnn_cnn"],
    visibility = ["//visibility:public"],
)

cc_import(
    name = "cudnn_adv",
    deps = [":headers"],
    shared_library = "lib/libcudnn_adv.so." + LIB_SONAME_VERSIONS["libcudnn_adv"],
    visibility = ["//visibility:public"],
)

cc_import(
    name = "cudnn_graph",
    deps = [":headers"],
    shared_library = "lib/libcudnn_graph.so." + LIB_SONAME_VERSIONS["libcudnn_graph"],
    visibility = ["//visibility:public"],
)

cc_import(
    name = "cudnn_engines_precompiled",
    deps = [":headers"],
    shared_library = "lib/libcudnn_engines_precompiled.so." + LIB_SONAME_VERSIONS["libcudnn_engines_precompiled"],
    visibility = ["//visibility:public"],
)

cc_import(
    name = "cudnn_engines_runtime_compiled",
    deps = [":headers"],
    shared_library = "lib/libcudnn_engines_runtime_compiled.so." + LIB_SONAME_VERSIONS["libcudnn_engines_runtime_compiled"],
    visibility = ["//visibility:public"],
)

cc_import(
    name = "cudnn_heuristic",
    deps = [":headers"],
    shared_library = "lib/libcudnn_heuristic.so." + LIB_SONAME_VERSIONS["libcudnn_heuristic"],
    visibility = ["//visibility:public"],
)

cc_import(
    name = "cudnn_main",
    deps = [":headers"],
    shared_library = "lib/libcudnn.so." + LIB_SONAME_VERSIONS["libcudnn"],
    visibility = ["//visibility:public"],
)

cc_import(
    name = "cudnn_ops_static",
    alwayslink = True,
    deps = [":headers"],
    static_library = "lib/libcudnn_ops_static.a",
)

cc_import(
    name = "cudnn_cnn_static",
    alwayslink = True,
    deps = [":headers"],
    static_library = "lib/libcudnn_cnn_static.a",
)

cc_import(
    name = "cudnn_adv_static",
    alwayslink = True,
    deps = [":headers"],
    static_library = "lib/libcudnn_adv_static.a",
)

cc_import(
    name = "cudnn_graph_static",
    alwayslink = True,
    deps = [":headers"],
    static_library = "lib/libcudnn_graph_static.a",
)

cc_import(
    name = "cudnn_engines_precompiled_static",
    alwayslink = True,
    deps = [":headers"],
    static_library = "lib/libcudnn_engines_precompiled_static.a",
)

cc_import(
    name = "cudnn_engines_runtime_compiled_static",
    alwayslink = True,
    deps = [":headers"],
    static_library = "lib/libcudnn_engines_runtime_compiled_static.a",
)

cc_import(
    name = "cudnn_heuristic_static",
    alwayslink = True,
    deps = [":headers"],
    static_library = "lib/libcudnn_heuristic_static.a",
)

cc_library(
    name = "cudnn",
    deps = [
        ":cudnn_engines_precompiled",
        ":cudnn_ops",
        ":cudnn_graph",
        ":cudnn_cnn",
        ":cudnn_adv",
        ":cudnn_engines_runtime_compiled",
        ":cudnn_heuristic",
        "@{cuda_redist_repo}//cublas:cublas",
        "@{cuda_redist_repo}//nvrtc:nvrtc",
        ":cudnn_main",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "cudnn_static",
    # cuDNN loads its tensor-IR engine internally. Direct linking can initialize
    # that engine incorrectly, including in releases that ship its static archive.
    alwayslink = True,
    deps = [
        ":cudnn_engines_precompiled_static",
        ":cudnn_ops_static",
        ":cudnn_graph_static",
        ":cudnn_cnn_static",
        ":cudnn_adv_static",
        ":cudnn_engines_runtime_compiled_static",
        ":cudnn_heuristic_static",
        "@{cuda_redist_repo}//cublas:cublas_static",
        "@{cuda_redist_repo}//cudart:static",
        "@{cuda_redist_repo}//nvrtc:nvrtc_static",
        "@zlib//:zlib",
    ],
    linkopts = ["-lrt"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "header_list",
    srcs = glob([
        "include/cudnn*.h",
    ]),
)

cc_library(
    name = "headers",
    hdrs = [":header_list"],
    deps = ["@{cuda_redist_repo}//cudart:headers"] + if_version_equal_or_greater_than(
        CUDA_VERSION,
        "13.0.0",
        ["@{cuda_redist_repo}//crt:headers"],
    ),
    includes = ["include"],
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
)
