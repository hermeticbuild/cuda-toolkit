"""BUILD definitions for cuda_cudnn package"""

# This BUILD file is used within the arch specific cuda redist repository.
#
# Any user-facing target should be listed in _REPO_PUBLIC_TARGETS so that the
# @cuda_cudnn proxy repository can re-export it.

load("@cuda_toolkit//cuda:versions_helper.bzl", "compare_versions", "if_version_equal_or_greater_than")
load("@rules_cc//cc:cc_import.bzl", "cc_import")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@{cuda_redist_repo}//:version.bzl", "CUDA_VERSION")
load("//:version.bzl", "LIB_VERSIONS")

# Tensor IR ships in cuDNN 9.21+, while supported 9.20 archives do not contain it.
_HAS_CUDNN_ENGINES_TENSOR_IR_VERSION = compare_versions(LIB_VERSIONS.get("libcudnn", ""), "9.21.0", ">=")
_HAS_CUDNN_ENGINES_TENSOR_IR = _HAS_CUDNN_ENGINES_TENSOR_IR_VERSION and "libcudnn_engines_tensor_ir" in LIB_VERSIONS
_CUDNN_ENGINES_TENSOR_IR_TARGET_COMPATIBLE_WITH = [] if _HAS_CUDNN_ENGINES_TENSOR_IR else ["@platforms//:incompatible"]
_CUDNN_ENGINES_TENSOR_IR_SHARED_VERSION = LIB_VERSIONS.get("libcudnn_engines_tensor_ir", "0")
_CUDNN_ENGINES_TENSOR_IR_DEPS = [":cudnn_engines_tensor_ir"] if _HAS_CUDNN_ENGINES_TENSOR_IR else []
_CUDNN_ENGINES_TENSOR_IR_STATIC_DEPS = [":cudnn_engines_tensor_ir_static"] if _HAS_CUDNN_ENGINES_TENSOR_IR else []

cc_import(
    name = "cudnn_ops",
    deps = [":headers"],
    shared_library = "lib/libcudnn_ops.so." + LIB_VERSIONS["libcudnn_ops"],
)

cc_import(
    name = "cudnn_cnn",
    deps = [":headers"],
    shared_library = "lib/libcudnn_cnn.so." + LIB_VERSIONS["libcudnn_cnn"],
)

cc_import(
    name = "cudnn_adv",
    deps = [":headers"],
    shared_library = "lib/libcudnn_adv.so." + LIB_VERSIONS["libcudnn_adv"],
)

cc_import(
    name = "cudnn_graph",
    deps = [":headers"],
    shared_library = "lib/libcudnn_graph.so." + LIB_VERSIONS["libcudnn_graph"],
)

cc_import(
    name = "cudnn_engines_precompiled",
    deps = [":headers"],
    shared_library = "lib/libcudnn_engines_precompiled.so." + LIB_VERSIONS["libcudnn_engines_precompiled"],
)

cc_import(
    name = "cudnn_engines_runtime_compiled",
    deps = [":headers"],
    shared_library = "lib/libcudnn_engines_runtime_compiled.so." + LIB_VERSIONS["libcudnn_engines_runtime_compiled"],
)

cc_import(
    name = "cudnn_engines_tensor_ir",
    deps = [":headers"],
    shared_library = "lib/libcudnn_engines_tensor_ir.so." + _CUDNN_ENGINES_TENSOR_IR_SHARED_VERSION,
    target_compatible_with = _CUDNN_ENGINES_TENSOR_IR_TARGET_COMPATIBLE_WITH,
    visibility = ["//visibility:public"],
)

cc_import(
    name = "cudnn_heuristic",
    deps = [":headers"],
    shared_library = "lib/libcudnn_heuristic.so." + LIB_VERSIONS["libcudnn_heuristic"],
)

cc_import(
    name = "cudnn_main",
    deps = [":headers"],
    shared_library = "lib/libcudnn.so." + LIB_VERSIONS["libcudnn"],
)

cc_import(
    name = "cudnn_ops_static",
    deps = [":headers"],
    static_library = "lib/libcudnn_ops_static.a",
)

cc_import(
    name = "cudnn_cnn_static",
    deps = [":headers"],
    static_library = "lib/libcudnn_cnn_static.a",
)

cc_import(
    name = "cudnn_adv_static",
    deps = [":headers"],
    static_library = "lib/libcudnn_adv_static.a",
)

cc_import(
    name = "cudnn_graph_static",
    deps = [":headers"],
    static_library = "lib/libcudnn_graph_static.a",
)

cc_import(
    name = "cudnn_engines_precompiled_static",
    deps = [":headers"],
    static_library = "lib/libcudnn_engines_precompiled_static.a",
)

cc_import(
    name = "cudnn_engines_runtime_compiled_static",
    deps = [":headers"],
    static_library = "lib/libcudnn_engines_runtime_compiled_static.a",
)

cc_import(
    name = "cudnn_engines_tensor_ir_static",
    deps = [":headers"],
    static_library = "lib/libcudnn_engines_tensor_ir_static.a",
    target_compatible_with = _CUDNN_ENGINES_TENSOR_IR_TARGET_COMPATIBLE_WITH,
    visibility = ["//visibility:public"],
)

cc_import(
    name = "cudnn_heuristic_static",
    deps = [":headers"],
    static_library = "lib/libcudnn_heuristic_static.a",
)

cc_library(
    name = "cudnn",
    deps = [
        ":cudnn_engines_precompiled",
        ":cudnn_ops",
        ":cudnn_graph",
        ":cudnn_cnn",
        ":cudnn_adv",
        ":cudnn_engines_runtime_compiled",
    ] + _CUDNN_ENGINES_TENSOR_IR_DEPS + [
        ":cudnn_heuristic",
        "@{cuda_redist_repo}//nvrtc:nvrtc",
        ":cudnn_main",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "cudnn_static",
    alwayslink = True,
    deps = [
        ":cudnn_engines_precompiled_static",
        ":cudnn_ops_static",
        ":cudnn_graph_static",
        ":cudnn_cnn_static",
        ":cudnn_adv_static",
        ":cudnn_engines_runtime_compiled_static",
    ] + _CUDNN_ENGINES_TENSOR_IR_STATIC_DEPS + [
        ":cudnn_heuristic_static",
        "@{cuda_redist_repo}//nvrtc:nvrtc_static",
    ],
    linkopts = ["-lrt", "-lz"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "header_list",
    srcs = glob([
        "include/cudnn*.h",
    ]),
)

cc_library(
    name = "headers",
    hdrs = [":header_list"],
    deps = ["@{cuda_redist_repo}//cudart:headers"] + if_version_equal_or_greater_than(
        CUDA_VERSION,
        "13.0.0",
        ["@{cuda_redist_repo}//crt:headers"],
    ),
    includes = ["include"],
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
)
